# API server
PORT=3002
DATABASE_PATH=./data/fixloop.sqlite
MAX_CRAWL_PAGES=200
# Optional path to a module exporting createAuditEngine() from Member A.
AUDIT_ENGINE_MODULE=

# Optional: when both are set, human-approved issues are filed to GitHub.
# Otherwise FixLoop uses a persistent local mock tracker.
GITHUB_TOKEN=
GITHUB_REPOSITORY=

# Optional: LLM wording only. The template drafter is used if unset or unavailable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
